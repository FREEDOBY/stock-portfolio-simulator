# 로컬 축적 데이터 (TrendForce 스팟 히스토리 등)
backend/data/

# 임시 산출물·덤프 (재생성 가능)
temps/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Frontend build
frontend/dist/

# 워크플로 도구 상태 파일
.workflow/

# IDE
.vscode/
.idea/

# Claude Code 로컬 설정 (사용자명·로컬 경로 포함 — 공유 대상 아님)
.claude/settings.local.json

# 로컬 전용 메모·결정 로그 (절대 커밋 금지)
CLAUDE.local.md
# .local.* 는 전부 로컬 전용으로 약속한다 (새 메모가 생겨도 기본 차단)
*.local.md
*.local.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment — 모든 비밀키는 .env 한 곳에만 둔다 (.env.example이 목록 역할)
.env
.env.*
!.env.example

# 편집·복사 중 생기는 사본 (원본이 비밀이면 사본도 비밀이다)
*.bak
*.orig
*~

# Vercel
.vercel

# ── 부동산: 로컬 사용자 데이터·비밀키 (커밋 금지) ──────────────
# 사용자 입력값 → funds.example.json만 공개
backend/realestate/funds.json
# 공공데이터 서비스키 + 개인 매수밴드·매크로 메모 → config.example.json만 공개
backend/realestate/config.json
# 추적 중인 관심 단지 목록
backend/realestate/profiles.json
# 수집 데이터·캐시 (용량이 크고 재생성 가능)
# 개별 파일명 대신 확장자로 막는다 — 새 캐시·DB가 생겨도 자동으로 차단되도록
backend/realestate/*.db
backend/realestate/*.db-journal
backend/realestate/*cache*.json

# 개인 문서 — 이 폴더 안에만 두면 커밋되지 않는다
docs/private/
# 내보낸 리포트·스크린샷 (사용자 데이터가 그대로 찍힌다)
reports/
exports/
*.local.html

# 화이트리스트: 위 패턴에 걸리지만 공개해야 하는 템플릿
!backend/realestate/*.example.json
