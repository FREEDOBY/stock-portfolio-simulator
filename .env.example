# 백엔드 환경변수 (.env 로 복사해서 값 채우기)

# FRED API 키 (미국 매크로 지표) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 공공데이터포털 인증키 (금융투자협회 신용공여잔고) — https://www.data.go.kr/data/15094809/openapi.do
# 발급 후 KOSPI 저점 판정기의 신용잔고가 자동 연동됨. 미설정 시 수동입력으로 폴백.
# Decoding(일반) 키를 그대로 넣으세요 (라이브러리가 인코딩 처리).
KOFIA_API_KEY=

# (선택) 오퍼레이션명이 가이드와 다를 경우 override
# KOFIA_CREDIT_OP=getCreditLoanRemainInfo

# 한국은행 ECOS 통계 API 키 (국내 금리·통화량) — https://ecos.bok.or.kr/api
# 미설정 시 'sample' 키로 동작하나 호출 한도가 매우 낮다.
ECOS_API_KEY=

# 공공데이터포털 서비스키 — 부동산 실거래가 수집(backend/realestate/fetcher.py)용.
# 미설정 시 KOFIA_API_KEY를 쓰고, 그것도 없으면 config.json의 service_key로 폴백한다.
# (포털 키가 하나라면 KOFIA_API_KEY만 채워도 된다)
DATA_GO_KR_KEY=

# SEC EDGAR 연락처 (TSMC 월매출·빅테크 캐펙스 조회 시 User-Agent에 요구됨).
# 개인 이메일이 저장소에 남지 않도록 여기서만 설정한다. 미설정 시 익명 기본값으로
# 동작하나, SEC가 과도호출 시 차단할 수 있으므로 본인 연락처 권장.
EDGAR_CONTACT=
